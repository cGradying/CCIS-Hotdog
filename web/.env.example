# The website is a read-only public view of the SAME data store the bot uses.
# Point it at the same backend so the site shows real, live data.
#
# Option 1: GitHub-as-database (matches the bot's config)
GITHUB_TOKEN=
GITHUB_DATA_REPO=yourname/your-data-repo
GITHUB_DATA_BRANCH=main
GITHUB_DATA_PATH=resources.json

# Option 2: MongoDB (only used if GITHUB_TOKEN is blank)
MONGODB_URI=

# Optional: public Discord invite link shown in the site header
NEXT_PUBLIC_DISCORD_INVITE=