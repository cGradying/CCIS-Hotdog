# --- Discord bot (this is a SEPARATE bot application from the schedule bot —
# create a new application at discord.com/developers/applications) ---
DISCORD_TOKEN=your-bot-token-here

# Channel where pending submissions get posted for mod approval
REVIEW_CHANNEL_ID=

# Role allowed to click Approve/Reject on the review queue.
# Leave blank to fall back to anyone with "Manage Server" permission.
MOD_ROLE_ID=

# --- Persistent storage: pick ONE, or leave all blank to use local files
# (fine on a host with a real disk — a VM, Oracle Cloud, your own PC) ---

# Option 1 (recommended if you're already using GitHub): store data as a
# JSON file in a repo, via the GitHub API. Use a small SEPARATE repo just
# for this — not the bot's own code repo — so submissions don't trigger a
# redeploy every time someone adds a resource.
# Token: github.com/settings/tokens -> generate (classic) -> "repo" scope
GITHUB_TOKEN=
GITHUB_DATA_REPO=yourname/your-data-repo
GITHUB_DATA_BRANCH=main
GITHUB_DATA_PATH=resources.json

# Option 2: MongoDB Atlas free tier (see the schedule bot's README for the
# walkthrough — you can reuse the same cluster, this bot uses its own DB
# name inside it). Only used if GITHUB_TOKEN above is blank.
MONGODB_URI=

# --- Announcement pipeline (/announce or `node scripts/run-pipeline.js`) ---
# Public Google Sheet (File > Share > "anyone with the link"), with an "Email"
# column listing everyone who should get the announcement.
GOOGLE_SHEET_URL=
SHEET_EMAIL_COLUMN=Email

# Gmail sender. Use an App Password (google.com/settings/security → App
# passwords) — NOT your normal account password. One email goes out with
# everyone else BCC'd.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Discord channel the /announce command posts the announcement + poster into
ANNOUNCEMENT_CHANNEL_ID=

# Content template — everything (email, Facebook caption, Discord embed,
# poster) is generated from these
ANNOUNCEMENT_TITLE=Class Announcement
ANNOUNCEMENT_DESCRIPTION=
MEETING_LINK=
MEETING_DATETIME=
EMAIL_SUBJECT=
EMAIL_FROM_NAME=Resource Vault

# Poster: banner image (export from Canva) + where the generated poster lands
BANNER_PATH=assets/banner.png
POSTER_OUTPUT_PATH=assets/poster.png
OUTPUT_DIR=output

# Facebook Page auto-post (leave blank to skip). Long-lived Page access token
# from developers.facebook.com → your app → Graph API Explorer, with
# pages_manage_posts + pages_read_engagement. Must be a Page token, not a user token.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
