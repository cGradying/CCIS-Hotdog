{
  "name": "resource-faq-bot",
  "version": "1.0.0",
  "description": "Discord bot for a per-subject resource/FAQ library — anyone can submit a resource, mods approve via buttons, everyone can pull it with /resources.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "self-check": "node scripts/self-check.js",
    "announce": "node scripts/run-pipeline.js",
    "announce:dry": "node scripts/run-pipeline.js --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "mongodb": "^6.10.0",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3"
  }
}
